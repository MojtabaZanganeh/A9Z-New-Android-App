function encrypt_config($data)
{
    global $API_KEY;
    $iv = openssl_random_pseudo_bytes(16);
    $encrypted = openssl_encrypt($data, 'aes-256-cbc', $API_KEY, 0, $iv);
    return base64_encode($encrypted . '::' . $iv);
}

function decrypt_config($data)
{
    global $API_KEY;
    list($encrypted_data, $iv) = explode('::', base64_decode($data), 2);
    return openssl_decrypt($encrypted_data, 'aes-256-cbc', $API_KEY, 0, $iv);
}

function generate_cpanel_100_password($length = 24)
{
    $uppers = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    $lowers = 'abcdefghijkmnpqrstuvwxyz';
    $numbers = '23456789';
    $symbols = '!@#$%^&*()_+-=~';

    $pass = [];
    for ($i = 0; $i < 4; $i++) {
        $pass[] = $uppers[random_int(0, strlen($uppers) - 1)];
        $pass[] = $lowers[random_int(0, strlen($lowers) - 1)];
        $pass[] = $numbers[random_int(0, strlen($numbers) - 1)];
        $pass[] = $symbols[random_int(0, strlen($symbols) - 1)];
    }

    $all = $uppers . $lowers . $numbers . $symbols;
    while (count($pass) < $length) {
        $pass[] = $all[random_int(0, strlen($all) - 1)];
    }

    shuffle($pass);
    return implode('', $pass);
}

function get_windscribe_usage_count($fingerprint, $cookie_id, $local_id, $ip, $period_days = 30)
{
    $quota_file = get_storage_path('windscribe_quota.json');
    if (!file_exists($quota_file)) return 0;
    $raw = @file_get_contents($quota_file);
    $records = json_decode($raw, true) ?: [];
    $cutoff = time() - ($period_days * 86400); // dynamic window based on settings
    $matched_emails = [];

    $has_device_id = !empty($fingerprint) || !empty($cookie_id) || !empty($local_id);

    foreach ($records as $r) {
        if (($r['timestamp'] ?? 0) < $cutoff) continue;
        $is_match = false;

        // 1. Precise device identification (Cookie, LocalStorage ID, Hardware Fingerprint)
        if (!empty($fingerprint) && !empty($r['fingerprint']) && $r['fingerprint'] === $fingerprint) {
            $is_match = true;
        } elseif (!empty($cookie_id) && !empty($r['cookie_id']) && $r['cookie_id'] === $cookie_id) {
            $is_match = true;
        } elseif (!empty($local_id) && !empty($r['local_id']) && $r['local_id'] === $local_id) {
            $is_match = true;
        } elseif (!$has_device_id && !empty($ip) && $ip !== '127.0.0.1' && $ip !== '::1' && !empty($r['ip']) && $r['ip'] === $ip) {
            // 2. Only fall back to IP matching if request has no device identification (e.g. curl / automated bot / disabled JS)
            // For distinct physical devices with different hardware fingerprints, do NOT punish them just because they share the same Wi-Fi / NAT IP.
            $is_match = true;
        }

        if ($is_match) {
            $key = $r['email'] ?? ($r['timestamp'] . '');
            $matched_emails[$key] = true;
        }
    }
    return count($matched_emails);
}

function parse_clean_email_body($headers_raw, $body_raw)
{
    $text = trim($body_raw);
    if (empty($text)) return '';

    // Check if multipart MIME
    $combined = $headers_raw . "\n" . $body_raw;
    $boundary = null;
    if (preg_match('/boundary="?([^"\r\n;]+)"?/i', $combined, $bm)) {
        $boundary = trim($bm[1]);
    } elseif (preg_match('/^--([a-zA-Z0-9_\-+=]{4,})/m', $body_raw, $bm2)) {
        $boundary = trim($bm2[1]);
    }

    if ($boundary) {
        $boundary_delim = (substr($boundary, 0, 2) === '--') ? $boundary : ('--' . $boundary);
        $parts = explode($boundary_delim, $text);
        $preferred_plain = '';
        $fallback_html = '';

        foreach ($parts as $part) {
            $part = trim($part);
            if (empty($part) || $part === '--') continue;

            $split = preg_split("/\r?\n\r?\n/", $part, 2);
            $p_headers = $split[0] ?? '';
            $p_body = $split[1] ?? $part;

            $is_plain = (stripos($p_headers, 'text/plain') !== false) || (!stripos($p_headers, 'text/html') && !stripos($p_headers, 'content-type'));
            $is_html = (stripos($p_headers, 'text/html') !== false);
            $is_base64 = (stripos($p_headers, 'base64') !== false) || (preg_match('/^[a-zA-Z0-9+\/=\s]{20,}$/', trim($p_body)));
            $is_qp = (stripos($p_headers, 'quoted-printable') !== false);

            $decoded = trim($p_body);
            if ($is_base64) {
                $cleaned = preg_replace('/\s+/', '', $decoded);
                $b64 = @base64_decode($cleaned);
                if ($b64 !== false && !empty($b64)) $decoded = $b64;
            } elseif ($is_qp) {
                $decoded = quoted_printable_decode($decoded);
            }

            if ($is_plain && empty($preferred_plain) && !empty($decoded)) {
                $preferred_plain = trim($decoded);
            } elseif ($is_html && empty($fallback_html) && !empty($decoded)) {
                $fallback_html = trim(strip_tags($decoded));
            }
        }

        if (!empty($preferred_plain)) return $preferred_plain;
        if (!empty($fallback_html)) return $fallback_html;
    }

    // Check single-part base64
    if (stripos($headers_raw, 'base64') !== false || stripos($text, 'Content-Transfer-Encoding: base64') !== false) {
        $split = preg_split("/\r?\n\r?\n/", $text, 2);
        $content = isset($split[1]) ? $split[1] : $text;
        $cleaned = preg_replace('/\s+/', '', $content);
        $b64 = @base64_decode($cleaned);
        if ($b64 !== false && !empty($b64)) return $b64;
    }

    // Check single-part quoted-printable
    if (stripos($headers_raw, 'quoted-printable') !== false || stripos($text, 'Content-Transfer-Encoding: quoted-printable') !== false) {
        $split = preg_split("/\r?\n\r?\n/", $text, 2);
        $content = isset($split[1]) ? $split[1] : $text;
        return quoted_printable_decode($content);
    }

    return $text;
}

function extract_windscribe_confirm_link($content)
{
    if (empty($content)) return null;
    // 1. Check href attribute in HTML (e.g. href="https://windscribe.com/signup/confirmemail/...")
    if (preg_match('/href=[\'"]([^\'"]*confirmemail[^\'"]*)[\'"]/i', $content, $m)) {
        return html_entity_decode(trim($m[1]));
    }
    // 2. Check full url with confirmemail
    if (preg_match('/https?:\/\/(?:www\.)?windscribe\.com\/[^\s"\'<>]*confirmemail[^\s"\'<>]*/i', $content, $m)) {
        return html_entity_decode(trim($m[0], '."\'()'));
    }
    // 3. Fallback for any confirmemail link
    if (preg_match('/https?:\/\/[^\s"\'<>]*confirmemail[^\s"\'<>]*/i', $content, $m)) {
        return html_entity_decode(trim($m[0], '."\'()'));
    }
    return null;
}

function AddHistory($config, $config_count)
{

    global $history_file;
    global $API_KEY;

    if (!file_exists($history_file)) {
        $history = [];
    } else {
        $history = json_decode(decrypt_config(file_get_contents($history_file)), true);
        if (!is_array(value: $history)) {
            $history = [];
        }
    }

    if (!empty($history)) {
        $last_version = end($history)["version"];
        [$x, $y] = explode('.', $last_version);
        $x = (int) $x;
        $y = (int) $y;

        if (++$y >= 10) {
            $y = 0;
            $x++;
        }
    } else {
        $x = 1;
        $y = 0;
    }

    $date = new DateTime("now", new DateTimeZone("Asia/Tehran"));
    $timestamp = $date->format('Y/m/d H:i');

    $new_config = [
        "content" => $config,
        "count" => $config_count,
        "timestamp" => $timestamp,
        "version" => "{$x}.{$y}"
    ];

    $history[] = $new_config;

    $hashed = encrypt_config(json_encode($history, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
    file_put_contents($history_file, $hashed);

}

function LoginHistory($role, $time, $success, $token, $last_time)
{
    global $login_file;

    if (!file_exists($login_file)) {
        $history = [];
    } else {
        $history = json_decode(file_get_contents($login_file), true);
        if (!is_array($history)) {
            $history = [];
        }
    }

    $id = end($history)['id'] + 1;

    $new_login = [
        'id' => $id,
        'role' => $role,
        'time' => $time,
        'success' => $success,
        'token' => $token,
        'last_time' => $last_time,
        'ip' => $_SERVER['REMOTE_ADDR'],
        'agent' => $_SERVER['HTTP_USER_AGENT']
    ];

    foreach ($history as $element) {
        if ($element === $new_login) {
            return "Exist";
        }
    }

    $history[] = $new_login;

    file_put_contents($login_file, json_encode($history, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
}

