    $records = [];
    if (file_exists($ws_file)) {
        $raw = file_get_contents($ws_file);
        $records = json_decode($raw, true) ?: [];
    }

    $now = time();
    foreach ($records as &$rec) {
        $email_addr = $rec['email'] ?? '';
        if (!isset($rec['is_user_request'])) {
            $rec['is_user_request'] = (strpos($email_addr, 'wsc_') === 0);
        }
        if (!isset($rec['created_timestamp'])) {
            $rec['created_timestamp'] = !empty($rec['created_at']) ? strtotime($rec['created_at']) : $now;
        }
        if (!isset($rec['expires_at'])) {
            $rec['expires_at'] = $rec['created_timestamp'] + 300;
        }
        $rec['is_expired'] = ($now >= $rec['expires_at']);
        $rec['remaining_seconds'] = max(0, $rec['expires_at'] - $now);
    }

    echo json_encode([
        'success' => true,
        'emails' => $records
    ]);
    http_response_code(200);

} elseif ($path == 'get-stats') {
    // 1. Logins statistics
    $login_file = get_storage_path('login.json');
    $logins = file_exists($login_file) ? (json_decode(file_get_contents($login_file), true) ?: []) : [];

    $user_logins = 0;
    $admin_logins = 0;
    $failed_logins = 0;
    $unique_login_ips = [];

    $now = time();
    $daily_cutoff = $now - 86400; // 24h
    $weekly_cutoff = $now - (7 * 86400); // 7 days
    $monthly_cutoff = $now - (30 * 86400); // 30 days
    $yearly_cutoff = $now - (365 * 86400); // 365 days

    $daily_user_logins = 0;
    $weekly_user_logins = 0;
    $monthly_user_logins = 0;
    $yearly_user_logins = 0;

    foreach ($logins as $l) {
        $is_user = (($l['role'] ?? '') !== 'admin');
        if (!empty($l['success'])) {
            if (!$is_user) {
                $admin_logins++;
            } else {
                $user_logins++;

                $t = 0;
                if (!empty($l['time']) && is_numeric($l['time'])) {
                    $t = (int)$l['time'];
                } elseif (!empty($l['last_time']) && is_numeric($l['last_time'])) {
                    $t = (int)$l['last_time'];
                } elseif (!empty($l['timestamp'])) {
                    $t = is_numeric($l['timestamp']) ? (int)($l['timestamp'] > 1e11 ? $l['timestamp']/1000 : $l['timestamp']) : (strtotime($l['timestamp']) ?: 0);
                } elseif (!empty($l['time']) && is_string($l['time'])) {
                    $t = strtotime($l['time']) ?: 0;
                }
                if ($t === 0) $t = $now;

                if ($t >= $daily_cutoff) $daily_user_logins++;
                if ($t >= $weekly_cutoff) $weekly_user_logins++;
                if ($t >= $monthly_cutoff) $monthly_user_logins++;
                if ($t >= $yearly_cutoff) $yearly_user_logins++;
            }
        } else {
            $failed_logins++;
        }
        if (!empty($l['ip'])) {
            $unique_login_ips[$l['ip']] = true;
        }
    }

    // Return all logins without slice limit so frontend pagination can show every record (e.g. all 41+)
    $recent_logins = array_reverse($logins);

    // 2. Windscribe emails stats - All-Time Cumulative Count
    // Counts all emails ever created/registered, even if deleted by admin or user-created and expired
    $ws_file = get_storage_path('windscribe_emails.json');
    $records = file_exists($ws_file) ? (json_decode(file_get_contents($ws_file), true) ?: []) : [];

    $del_file = get_storage_path('deleted_emails.json');
    $deleted_records = file_exists($del_file) ? (json_decode(file_get_contents($del_file), true) ?: []) : [];

    $history_file = get_storage_path('windscribe_emails_history.json');
    $history_records = file_exists($history_file) ? (json_decode(file_get_contents($history_file), true) ?: []) : [];

    $quota_file = get_storage_path('windscribe_quota.json');
    $quota_records = file_exists($quota_file) ? (json_decode(file_get_contents($quota_file), true) ?: []) : [];

    // Aggregate unique all-time created emails
    $all_time_emails_map = [];

    // 1) From permanent history file
    foreach ($history_records as $hr) {
        $em = strtolower(trim($hr['email'] ?? ''));
        if ($em) {
            $all_time_emails_map[$em] = $hr;
        }
    }

    // 2) From current active emails
    foreach ($records as $r) {
        $em = strtolower(trim($r['email'] ?? ''));
        if ($em) {
            if (!isset($all_time_emails_map[$em])) {
                $all_time_emails_map[$em] = $r;
            } else {
                if (!empty($r['link']) || !empty($r['code']) || ($r['status'] ?? '') === 'verified') {
                    $all_time_emails_map[$em]['status'] = 'verified';
                    if (!empty($r['link'])) $all_time_emails_map[$em]['link'] = $r['link'];
                    if (!empty($r['code'])) $all_time_emails_map[$em]['code'] = $r['code'];
                }
            }
        }
    }

    // 3) From deleted emails
    foreach ($deleted_records as $k => $dv) {
        $em = strtolower(trim(is_array($dv) ? ($dv['email'] ?? $k) : (is_string($k) && strpos($k, '@') !== false ? $k : $dv)));
        if ($em && !isset($all_time_emails_map[$em])) {
            $all_time_emails_map[$em] = [
                'email' => $em,
                'is_deleted' => true,
                'is_user_request' => (strpos($em, 'wsc_') === 0)
            ];
        }
    }

    // 4) From quota records (user requested emails)
    foreach ($quota_records as $qr) {
        $em = strtolower(trim($qr['email'] ?? ''));
        if ($em && !isset($all_time_emails_map[$em])) {
            $all_time_emails_map[$em] = [
                'email' => $em,
                'is_user_request' => true
            ];
        }
    }

    // Sync back to history file if any active or deleted emails weren't recorded yet
    if (count($all_time_emails_map) > count($history_records)) {
        file_put_contents($history_file, json_encode(array_values($all_time_map ?? $all_time_emails_map), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
    }

    $total_emails = count($all_time_emails_map);
    $verified_emails = 0;
    $pending_emails = 0;
    $active_emails = 0;
    $user_created_emails = 0;
    $admin_created_emails = 0;
    $now = time();

    foreach ($all_time_emails_map as $em => $rec) {
        $is_user = !empty($rec['is_user_request']) || (strpos($em, 'wsc_') === 0);
        if ($is_user) {
            $user_created_emails++;
        } else {
            $admin_created_emails++;
        }

        if (!empty($rec['link']) || !empty($rec['code']) || ($rec['status'] ?? '') === 'verified') {
            $verified_emails++;
        } else {
            $pending_emails++;
        }
    }

    foreach ($records as $r) {
        if (!empty($r['expires_at']) && $r['expires_at'] > $now) {
            $active_emails++;
        }
    }

    // 3. Unique users who received emails
    $quota_file = get_storage_path('windscribe_quota.json');
    $quota_records = file_exists($quota_file) ? (json_decode(file_get_contents($quota_file), true) ?: []) : [];

    $unique_users_map = [];
    foreach ($quota_records as $qr) {
        $uid = !empty($qr['fingerprint']) ? $qr['fingerprint'] : (!empty($qr['cookie_id']) ? $qr['cookie_id'] : ($qr['ip'] ?? ''));
        if (!empty($uid)) {
            $unique_users_map[$uid] = true;
        }
    }
    foreach ($records as $r) {
        if (!empty($r['is_user_request'])) {
            $uid = $r['fingerprint'] ?? ($r['cookie_id'] ?? ($r['ip'] ?? $r['email']));
            if (!empty($uid)) {
                $unique_users_map[$uid] = true;
            }
        }
    }

    $unique_users_count = count($unique_users_map);

    // 4. Settings
    $settings = get_app_settings();

    $stats_payload = [
        'logins' => [
            'total_user_logins' => $user_logins,
            'total_admin_logins' => $admin_logins,
            'total_attempts' => count($logins),
            'failed_logins' => $failed_logins,
            'unique_ips' => count($unique_login_ips),
            'daily_user_logins' => $daily_user_logins,
            'weekly_user_logins' => $weekly_user_logins,
            'monthly_user_logins' => $monthly_user_logins,
            'yearly_user_logins' => $yearly_user_logins,
            'recent_logins' => $recent_logins
        ],
        'emails' => [
            'total_created' => $total_emails,
            'user_created' => $user_created_emails,
            'admin_created' => $admin_created_emails,
            'total_verified' => $verified_emails,
            'total_pending' => $pending_emails,
            'active_not_expired' => $active_emails
        ],
        'users' => [
            'unique_users_received_emails' => $unique_users_count,
            'total_quota_records' => count($quota_records)
        ],
        'settings' => $settings
    ];

    echo json_encode([
        'success' => true,
        'stats' => $stats_payload,
        'data' => $stats_payload
    ]);
    http_response_code(200);
}
