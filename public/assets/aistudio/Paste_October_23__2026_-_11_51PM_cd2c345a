function get_storage_path($filename)
{
    global $data_dir;
    $new_path = $data_dir . '/' . $filename;
    $old_path = __DIR__ . '/' . $filename;
    if (!file_exists($new_path) && file_exists($old_path)) {
        @rename($old_path, $new_path);
    }
    return file_exists($new_path) ? $new_path : (file_exists($old_path) ? $old_path : $new_path);
}

